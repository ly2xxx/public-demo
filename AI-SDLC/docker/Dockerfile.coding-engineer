# Multi-stage, non-root, pinned. The agent's container is the blast radius, so
# it gets no build tools and no root.
FROM python:3.12-slim-bookworm AS build
WORKDIR /build
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /bin/uv
COPY pyproject.toml uv.lock* ./
RUN uv export --no-hashes --no-dev -o requirements.txt 2>/dev/null || touch requirements.txt \
 && uv pip install --system --target /deps -r requirements.txt

FROM python:3.12-slim-bookworm
# git is a genuine runtime dependency here: the loop works in a worktree and
# commits its own branch. It is the only tool added beyond the interpreter.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 1000 --create-home --shell /usr/sbin/nologin agent
ENV PYTHONPATH=/deps PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY --from=build /deps /deps
COPY --chown=root:root gate/ /app/gate/
COPY --chown=root:root coding_agent/ /app/coding_agent/
WORKDIR /work
USER 1000
# Liveness for a Job is the Job controller's problem; this only tells docker
# whether the image is fundamentally broken.
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import sys; sys.exit(0)"
ENTRYPOINT ["python", "-m", "coding_agent"]
