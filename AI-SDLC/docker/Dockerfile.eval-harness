# The nightly regression gate. Deliberately thinner than the agent image: it
# reads the frozen task set, calls the gateway, and writes scores. It never
# checks out or executes a repository.
FROM python:3.12-slim-bookworm
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin evaluator
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY --chown=root:root eval/ /app/eval/
WORKDIR /app
USER 1000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import sys; sys.exit(0)"
ENTRYPOINT ["python", "eval/run_eval.py"]
