      "roundness": null,
      "seed": 744315616,
      "version": 167,
      "versionNonce": 1753349368,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788373221462,
      "link": null,
      "locked": false,
      "index": "b15",
      "text": "• hash(session_id) → the node holding the\n   live Web Chat / Email WebSocket\n• Agent memory + conversation state stay\n   on that node — no cross-node fetch\n• Reconnects land on the same node while\n   the ring is stable\n• Virtual nodes spread hot sessions evenly\n   across servers",
      "originalText": "• hash(session_id) → the node holding the\n   live Web Chat / Email WebSocket\n• Agent memory + conversation state stay\n   on that node — no cross-node fetch\n• Reconnects land on the same node while\n   the ring is stable\n• Virtual nodes spread hot sessions evenly\n   across servers",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.2,
      "autoResize": true,
      "baseline": 12
