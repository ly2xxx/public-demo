      "isDeleted": false,
      "boundElements": [],
      "updated": 1787144207106,
      "link": null,
      "locked": false,
      "index": "b0x",
      "text": "Selection rule:  < 10k rows → full table scan  ·  full-text → inverted  ·  lat/long → geospatial  ·  in-memory exact match → hash  ·  everything else → B-Tree",
      "originalText": "Selection rule:  < 10k rows → full table scan  ·  full-text → inverted  ·  lat/long → geospatial  ·  in-memory exact match → hash  ·  everything else → B-Tree",
