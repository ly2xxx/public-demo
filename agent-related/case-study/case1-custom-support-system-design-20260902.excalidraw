      "isDeleted": false,
      "boundElements": [],
      "updated": 1787144207106,
      "link": null,
      "locked": false,
      "text": "{\n \"route_decision\": {\n   \"target_agent\": \"return_planner\",\n   \"intent\": \"order_return_request\",\n   \"confidence\": 0.96,\n   \"requires_human\": false },\n \"response\": {\n   \"text\": \"Could you share your order #?\",\n   \"suggested_actions\": [\"Enter Order #\"] },\n \"session_state\": {\n   \"current_step\": \"awaiting_order_id\",\n   \"context_params\": {...} }\n}",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "{\n \"route_decision\": {\n   \"target_agent\": \"return_planner\",\n   \"intent\": \"order_return_request\",\n   \"confidence\": 0.96,\n   \"requires_human\": false },\n \"response\": {\n   \"text\": \"Could you share your order #?\",\n   \"suggested_actions\": [\"Enter Order #\"] },\n \"session_state\": {\n   \"current_step\": \"awaiting_order_id\",\n   \"context_params\": {...} }\n}",
      "lineHeight": 1.25,
      "index": "b0a",
      "autoResize": true
    },
    {
      "id": "tY05LLqWU2XxGs5kQu38z",
      "type": "text",
      "x": 635.9258930749274,
      "y": 1760.984015012085,
      "width": 1250,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1554498737,
      "version": 169,
      "versionNonce": 1398016396,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787144207106,
      "link": null,
      "locked": false,
      "text": "route_decision tells the client / downstream orchestrator which specialist agent handles the request\n(qa_agent, return_planner, or human_escalation).  session_state carries minimal context across turns\nto avoid re-extracting user intent on subsequent requests.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "route_decision tells the client / downstream orchestrator which specialist agent handles the request\n(qa_agent, return_planner, or human_escalation).  session_state carries minimal context across turns\nto avoid re-extracting user intent on subsequent requests.",
      "lineHeight": 1.25,
      "index": "b0b",
      "autoResize": true
    },
