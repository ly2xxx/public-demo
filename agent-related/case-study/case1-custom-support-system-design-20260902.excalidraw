      "boundElements": [],
      "updated": 1788373064774,
      "link": null,
      "locked": false,
      "text": "POST /v1/conversations/conv_88310/messages\nHost: agent-router.internal.service\nContent-Type: application/json\nAuthorization: Bearer <jwt_token>\n\n{\n  \"user_id\": \"usr_9120\",\n  \"channel\": \"web_chat\",\n  \"message\": \"I want to return my shoes,\n               they are too small.\",\n  \"metadata\": {\n    \"locale\": \"en-US\",\n    \"authenticated\": true\n  }\n}",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
